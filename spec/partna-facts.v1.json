{
  "openapi": "3.1.0",
  "info": {
    "title": "Partna facts",
    "version": "1.0.0",
    "description": "Факты партнёрской программы: привязка клиента к коду партнёра, участник, заказ, возврат и ссылка партнёра. Ключ тенанта передаётся на сервере, в браузер не попадает."
  },
  "paths": {
    "/v1/claim": {
      "post": {
        "summary": "Claim",
        "operationId": "claim_v1_claim_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/partner-link": {
      "post": {
        "summary": "Partner Link",
        "operationId": "partner_link_v1_partner_link_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerLinkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order": {
      "post": {
        "summary": "Order",
        "operationId": "order_v1_order_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderFact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/refund": {
      "post": {
        "summary": "Refund",
        "operationId": "refund_v1_refund_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundFact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/member": {
      "post": {
        "summary": "Member",
        "operationId": "member_v1_member_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberFact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "default": ""
          },
          "externalAccountId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Externalaccountid"
          }
        },
        "type": "object",
        "required": [
          "externalAccountId"
        ],
        "title": "ClaimRequest"
      },
      "ClaimResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "sponsorId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sponsorid"
          },
          "memberId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memberid"
          },
          "claimedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimedat"
          },
          "eventId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventid"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ClaimResponse",
        "description": "Привязка клиента к коду партнёра: сразу или через очередь."
      },
      "FactResponse": {
        "properties": {
          "queued": {
            "type": "boolean",
            "title": "Queued"
          },
          "eventId": {
            "type": "string",
            "title": "Eventid"
          },
          "engine": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "queued",
          "eventId"
        ],
        "title": "FactResponse",
        "description": "Ответ на заказ, возврат или участника."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResult": {
        "properties": {
          "eventId": {
            "type": "string",
            "title": "Eventid"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "eventId",
          "status",
          "duplicate"
        ],
        "title": "IngestResult"
      },
      "LinkResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "code",
          "url"
        ],
        "title": "LinkResponse"
      },
      "MemberFact": {
        "properties": {
          "eventId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Eventid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          },
          "memberId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Memberid"
          },
          "sponsorId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Sponsorid"
          },
          "placementId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Placementid"
          },
          "leg": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Leg"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "title": "Status",
            "default": "active"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "eventId",
          "occurredAt",
          "memberId"
        ],
        "title": "MemberFact"
      },
      "OrderFact": {
        "properties": {
          "eventId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Eventid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          },
          "orderId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Orderid"
          },
          "memberId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Memberid"
          },
          "amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency"
          },
          "personalVolume": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Personalvolume"
          },
          "productId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Productid"
          },
          "eventAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventat"
          },
          "retailAmount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retailamount"
          },
          "certificateAmount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Certificateamount"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "eventId",
          "occurredAt",
          "orderId",
          "memberId",
          "amount",
          "currency",
          "personalVolume"
        ],
        "title": "OrderFact"
      },
      "PartnerLinkRequest": {
        "properties": {
          "externalAccountId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Externalaccountid"
          },
          "destinationUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destinationurl"
          }
        },
        "type": "object",
        "required": [
          "externalAccountId"
        ],
        "title": "PartnerLinkRequest"
      },
      "RefundFact": {
        "properties": {
          "eventId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Eventid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          },
          "refundId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Refundid"
          },
          "orderId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Orderid"
          },
          "memberId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Memberid"
          },
          "amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "eventId",
          "occurredAt",
          "refundId",
          "orderId",
          "amount",
          "currency"
        ],
        "title": "RefundFact"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
